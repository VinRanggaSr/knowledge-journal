# Set variabel ini di Netlify dashboard: Site settings > Environment variables
# JANGAN commit nilai asli ke git.

APPS_SCRIPT_URL=https://script.google.com/macros/s/xxxxxxxx/exec
APPS_SCRIPT_SHARED_SECRET=isi-dengan-secret-acak-yang-sama-dengan-Script-Properties

# Password gate — server-only, TIDAK diawali VITE_ supaya tidak pernah ter-bundle ke frontend
SITE_PASSWORD=vcknowledge
